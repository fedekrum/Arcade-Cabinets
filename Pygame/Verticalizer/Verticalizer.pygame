#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import sys, os, time, threading
from typing import Dict, Any, Optional

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, BASE_DIR)
sys.path.insert(0, os.path.join(BASE_DIR, 'resources'))
import verticalizer_core as core

def setup_verticalizer_metadata():
    """Verifica y actualiza gamelist.xml y copia la imagen si es necesario."""
    try:
        import xml.etree.ElementTree as ET
        import shutil
        
        pygame_dir = "/userdata/roms/pygame"
        gamelist_path = os.path.join(pygame_dir, "gamelist.xml")
        images_dir = os.path.join(pygame_dir, "images")
        verticalizer_dir = os.path.join(pygame_dir, "Verticalizer")
        game_path = "./Verticalizer/Verticalizer.pygame"
        game_name = "Verticalizer"
        image_name = "Verticalizer.png"
        image_path_in_images = os.path.join(images_dir, image_name)
        image_path_in_game = None
        
        # Buscar imagen en carpeta Verticalizer
        for img_name in ["Verticalizer.png", "Verticalizer.PNG", "icon.png", "logo.png", "verticalizer.png"]:
            img_path = os.path.join(verticalizer_dir, img_name)
            if os.path.exists(img_path):
                image_path_in_game = img_path
                break
        
        # Verificar/crear gamelist.xml
        if os.path.exists(gamelist_path):
            try:
                tree = ET.parse(gamelist_path)
                root = tree.getroot()
            except:
                root = ET.Element("gameList")
                tree = ET.ElementTree(root)
        else:
            root = ET.Element("gameList")
            tree = ET.ElementTree(root)
            os.makedirs(os.path.dirname(gamelist_path), exist_ok=True)
        
        # Verificar si ya existe la entrada
        game_exists = False
        for game in root.findall("game"):
            path_elem = game.find("path")
            if path_elem is not None and path_elem.text == game_path:
                game_exists = True
                image_elem = game.find("image")
                if image_elem is None or not image_elem.text:
                    if os.path.exists(image_path_in_images):
                        if image_elem is None:
                            image_elem = ET.SubElement(game, "image")
                        image_elem.text = f"./images/{image_name}"
                break
        
        # Si no existe, agregar entrada
        if not game_exists:
            game_elem = ET.SubElement(root, "game")
            path_elem = ET.SubElement(game_elem, "path")
            path_elem.text = game_path
            name_elem = ET.SubElement(game_elem, "name")
            name_elem.text = game_name
            
            if os.path.exists(image_path_in_images):
                image_elem = ET.SubElement(game_elem, "image")
                image_elem.text = f"./images/{image_name}"
        
        # Guardar gamelist.xml
        ET.indent(tree, space="	")
        tree.write(gamelist_path, encoding="utf-8", xml_declaration=True)
        
        # Copiar imagen si no existe en images/ pero sí en Verticalizer/
        if not os.path.exists(image_path_in_images):
            if image_path_in_game and os.path.exists(image_path_in_game):
                os.makedirs(images_dir, exist_ok=True)
                shutil.copy2(image_path_in_game, image_path_in_images)
                
                # Actualizar gamelist.xml con la imagen
                tree = ET.parse(gamelist_path)
                root = tree.getroot()
                for game in root.findall("game"):
                    path_elem = game.find("path")
                    if path_elem is not None and path_elem.text == game_path:
                        image_elem = game.find("image")
                        if image_elem is None:
                            image_elem = ET.SubElement(game, "image")
                        image_elem.text = f"./images/{image_name}"
                        ET.indent(tree, space="	")
                        tree.write(gamelist_path, encoding="utf-8", xml_declaration=True)
        
        return True
        
    except Exception as e:
        print(f"[ERROR] Error en setup_verticalizer_metadata: {e}")
        import traceback
        traceback.print_exc()
        return False


class VerticalizerUI:
    def __init__(self):
        # Configurar metadata al inicio
        setup_verticalizer_metadata()
        self.result: Dict[str, Any] = {"done": False, "data": None, "error": None, "progress": "", "auto_exit": False}
        self.spin_index = 0
        self.spinner = ["-", "\\", "|", "/"]
        self.start_time = time.time()
        self.current_step = 0
        self.completed_steps = set()
        
        # Definir los pasos correctos basados en el flujo real
        self.steps = [
            "Validando directorios de ROMs",
            "Cargando listas vertical.txt y horizontal.txt",
            "Generando listas desde MAME (si no existen)",
            "Moviendo ROMs verticales a carpeta vertical",
            "Verificando juegos horizontales mal ubicados",
            "Moviendo ROMs horizontales de vuelta a MAME",
            "Moviendo imágenes asociadas",
            "Creando carpetas de imágenes",
            "Migrando gamelist.xml desde MAME original",
            "Recargando EmulationStation"
        ]
        
    def worker_thread(self):
        """Worker thread that runs the core verticalizer."""
        try:
            # Ejecutar el proceso real directamente
            self.result["progress"] = "Iniciando proceso..."
            self.current_step = 0
            
            # Ejecutar el proceso real
            self.result["data"] = core.verticalize()
            
            # Marcar todos los pasos como completados
            for i in range(len(self.steps)):
                self.completed_steps.add(i)
            
            self.result["progress"] = "Proceso completado"
            
        except Exception as e:
            self.result["error"] = str(e)
            self.result["progress"] = "Error en el proceso"
        finally:
            self.result["done"] = True
            # Auto-exit after 3 seconds
            time.sleep(3)
            self.result["auto_exit"] = True

    def get_elapsed_time(self) -> str:
        """Get formatted elapsed time."""
        elapsed = int(time.time() - self.start_time)
        if elapsed < 60:
            return f"{elapsed} segundos"
        else:
            minutes = elapsed // 60
            seconds = elapsed % 60
            return f"{minutes} minutos {seconds} segundos"

    def render_loading_screen(self, screen, font, small_font, W: int, H: int) -> None:
        """Render the loading screen with current step only."""
        self.spin_index = (self.spin_index + 1) % len(self.spinner)
        
        # Title
        title = f"{self.spinner[self.spin_index]}  MAME VERTICALIZER"
        title_surface = font.render(title, True, (100, 150, 255))
        screen.blit(title_surface, (20, 20))
        
        # Current status
        status = self.result["progress"] if self.result["progress"] else "Iniciando..."
        status_surface = small_font.render(f"Estado: {status}", True, (255, 255, 255))
        screen.blit(status_surface, (20, 60))
        
        # Time elapsed
        time_surface = small_font.render(f"Tiempo transcurrido: {self.get_elapsed_time()}", True, (200, 200, 200))
        screen.blit(time_surface, (20, 85))
        
        # Current step (only one step visible)
        y = 120
        for i, step in enumerate(self.steps):
            if i == self.current_step:
                # Current step in white
                color = (255, 255, 255)
                step_text = f"• {step}"
            elif i in self.completed_steps:
                # Completed steps in green
                color = (100, 255, 100)
                step_text = f"✓ {step}"
            else:
                # Future steps not shown
                continue
                
            step_surface = small_font.render(step_text, True, color)
            screen.blit(step_surface, (20, y))
            y += 30
        
        # Instructions
        if self.result.get("auto_exit", False):
            instructions = "Saliendo automaticamente en 3 segundos..."
        else:
            instructions = "Presiona ESC para cancelar"
        inst_surface = small_font.render(instructions, True, (120, 120, 120))
        screen.blit(inst_surface, (20, H - 30))

    def render_result_screen(self, screen, font, small_font, W: int, H: int) -> None:
        """Render the result screen."""
        if self.result["error"]:
            # Error screen
            title = "ERROR"
            title_surface = font.render(title, True, (255, 100, 100))
            screen.blit(title_surface, (20, 20))
            
            error_msg = self.result["error"]
            error_surface = small_font.render(f"Error: {error_msg}", True, (255, 200, 200))
            screen.blit(error_surface, (20, 60))
            
        else:
            # Success screen
            summary, moved, missing, total_vertical, created, xml_saved = self.result["data"]
            success_rate = (moved / total_vertical * 100) if total_vertical > 0 else 0
            
            title = "PROCESO COMPLETADO"
            title_surface = font.render(title, True, (100, 255, 100))
            screen.blit(title_surface, (20, 20))
            
            # Results
            results = [
                f"Juegos verticales detectados: {total_vertical}",
                f"ROMs verticales movidos: {moved}",
                f"ROMs verticales faltantes: {missing}",
                f"Tasa de éxito: {success_rate:.1f}%",
                f"Tiempo total: {self.get_elapsed_time()}"
            ]
            
            y = 60
            for result in results:
                result_surface = small_font.render(result, True, (255, 255, 255))
                screen.blit(result_surface, (20, y))
                y += 25
            
            # Files created
            gamelist_path = os.path.join(core.ROMS_MAME_VERTICAL, "gamelist.xml")
            files_info = [
                f"Archivos creados:",
                f"  - vertical.txt ({'OK' if os.path.exists('vertical.txt') else 'FALTA'})",
                f"  - horizontal.txt ({'OK' if os.path.exists('horizontal.txt') else 'FALTA'})",
                f"  - gamelist.xml ({'OK' if os.path.exists(gamelist_path) else 'FALTA'})",
                f"  - mame_verticalizer.log ({'OK' if os.path.exists('mame_verticalizer.log') else 'FALTA'})"
            ]
            
            y = 200
            for info in files_info:
                color = (255, 255, 255) if info.startswith("Archivos") else (200, 200, 200)
                info_surface = small_font.render(info, True, color)
                screen.blit(info_surface, (20, y))
                y += 20
        
        # Instructions
        if self.result.get("auto_exit", False):
            instructions = "Saliendo automaticamente en 3 segundos..."
        else:
            instructions = "Presiona ESC/ENTER/SPACE para salir"
        inst_surface = small_font.render(instructions, True, (120, 120, 120))
        screen.blit(inst_surface, (20, H - 30))

    def run(self) -> int:
        """Main UI loop."""
        try:
            import pygame
            pygame.init()
            
            # Get screen dimensions for fullscreen
            info = pygame.display.Info()
            W, H = info.current_w, info.current_h
            screen = pygame.display.set_mode((W, H))
            pygame.display.set_caption("MAME Verticalizer v2.0")
            
            # Try to load better fonts
            try:
                font = pygame.font.Font(None, 24)
                small_font = pygame.font.Font(None, 18)
            except:
                font = pygame.font.SysFont("monospace", 20)
                small_font = pygame.font.SysFont("monospace", 16)
            
            clock = pygame.time.Clock()
            
            # Start worker thread
            worker = threading.Thread(target=self.worker_thread, daemon=True)
            worker.start()
            
            while True:
                for event in pygame.event.get():
                    if event.type == pygame.QUIT:
                        pygame.quit()
                        return 0
                    elif event.type == pygame.KEYDOWN:
                        if event.key == pygame.K_ESCAPE:
                            if self.result["done"]:
                                pygame.quit()
                                return 0
                        elif event.key in (pygame.K_RETURN, pygame.K_SPACE) and self.result["done"]:
                            pygame.quit()
                            return 0
                
                # Auto-exit when process is done
                if self.result.get("auto_exit", False):
                    pygame.quit()
                    return 0
                
                # Clear screen
                screen.fill((15, 15, 20))
                
                # Draw content based on state
                if not self.result["done"]:
                    self.render_loading_screen(screen, font, small_font, W, H)
                else:
                    self.render_result_screen(screen, font, small_font, W, H)
                
                pygame.display.flip()
                clock.tick(15)
            
        except Exception as e:
            print(f"[UI ERROR] {e}")
            print("[FALLBACK] Running core without UI...")
            try:
                result = core.verticalize()
                print(f"[RESULT] {result[0]}")
                return 0
            except Exception as core_error:
                print(f"[CORE ERROR] {core_error}")
                return 1

def main() -> int:
    """Main entry point."""
    ui = VerticalizerUI()
    return ui.run()

if __name__ == "__main__":
    sys.exit(main())